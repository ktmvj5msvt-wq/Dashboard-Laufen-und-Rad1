# Öffentliche Adresse mit https:// (für den Strava-Redirect und die Konnektor-URL)
BASE_URL=https://energietechnik-suhr.store

# Zugang zum Dashboard (Browser). Leer lassen = beim ersten Start wird ein Passwort erzeugt und in data/dash_password gespeichert.
DASH_USER=trainer
DASH_PASSWORD=

# Geheimer Pfadteil der Claude-Konnektor-URL. Leer lassen = wird erzeugt (data/mcp_secret).
MCP_SECRET=

# Strava-API-Anwendung (https://www.strava.com/settings/api), Callback-Domain = Domain aus BASE_URL
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Garmin (inoffiziell). Mit Zwei-Faktor-Anmeldung stattdessen einmalig: docker compose run --rm dashboard python -m app.garmin_login
GARMIN_EMAIL=
GARMIN_PASSWORD=

# Optional
SYNC_INTERVAL_MIN=60
HISTORY_DAYS=450
STREAM_BUDGET=20
SEED_PLAN=1
